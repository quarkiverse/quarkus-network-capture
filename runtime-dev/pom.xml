<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.quarkiverse.networkcapture</groupId>
        <artifactId>quarkus-network-capture-parent</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>

    <artifactId>quarkus-network-capture-dev</artifactId>
    <name>Quarkus - Network Capture - Runtime Dev mode</name>
    <description>Capture network traffic from the Dev UI - Dev mode only</description>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.networkcapture</groupId>
            <artifactId>quarkus-network-capture</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.networkcapture</groupId>
            <artifactId>network-capture-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.smallrye.reactive</groupId>
            <artifactId>mutiny</artifactId>
        </dependency>
        <!-- Only for the filter and the download route of the Dev UI page, which exist only when the application
             has the HTTP layer; the extension itself does not need it -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
